# Blinker 設定ファイル (blinker.exe と同じフォルダに blinker.ini として置く)
# 行頭 # または ; はコメント

[view]
# 背景色 (RRGGBB)
background = 202020
# タイトルバー・ステータスバーのテーマ: auto (OSのアプリテーマ設定に追従) / dark / light
theme = auto
# ステータスバー(画像情報・カーソル位置の座標と色・コピー通知)を表示するか
statusbar = true
# サイドバー(ファイル名一覧、Ctrl+Bでトグル。テキスト注釈の選択中は太字トグルが優先)
# を起動時に表示するか
sidebar = false
# サイドバーの起動時の幅 (px, 120-480)。表示中は右端をドラッグしても変えられる
# (ドラッグでの変更は保存されないので、既定を変えたいならこの値を書き換える)
# 操作一覧 (F1) を出している間だけは、狭くても 300px まで広げて表示する
sidebar_width = 220
# 「F1 で操作一覧」の案内をステータスバーに数秒間出すか。
# 出るのは起動時と、どのコマンドにも割り当てられていないキーを押したとき
help_hint = true
# ビューポートの左右の端にポインタを近づけたとき、前後の画像へ移るボタン(◀ ▶)を
# 重ねて出すか。ボタンの上でクリックしたときだけ効く(端をクリックしただけでは動かない)。
# 先頭・末尾では行き先が無い側は出ない。邪魔なら false で完全に消せる
nav_arrows = true
# フィット表示時にウィンドウより小さい画像を拡大するか
fit_upscale = false
# 一覧の並び順: name(名前) / date(更新日時) / size(サイズ) / ext(種類)。
# 表示中はサイドバー(ファイル名一覧)の右クリックメニューから切り替えられる。
# 並び替えても表示中の画像は変わらない(番号だけが変わる)
sort = name
# 降順にするか(date で true なら新しい順、size で true なら大きい順)。
# 主キーが同じ画像どうしの並びは、降順でも名前の昇順のまま
sort_descending = false
# サブフォルダの画像も一覧に含めるか。並び順は「フォルダ → ファイル名」になり、
# サイドバーには起点フォルダからの相対パスが出る(ステータスバーに
# 「サブフォルダ含む」と表示される)。シンボリックリンクと隠しフォルダは辿らず、
# 100000 件で打ち切る。走査は裏で行うので、大きなツリーでも起動は待たされない
# (まずフォルダ直下の画像が出て、走査が終わると一覧が増える)
recursive = false
# 前後何枚を先読みするか (0-8)
prefetch_radius = 2
# 埋め込みカラープロファイル (ICC) を sRGB へ変換して表示するか。
# Display P3 で撮った写真(最近のスマートフォンの既定)などが正しい色で出る。
# 変換自体は 2400万画素で 0.5 秒ほどかかるので、まず変換せずに表示して、
# 裏で変換が終わったら差し替える(待たされない代わりに、開いた直後の一瞬だけ
# 変換前の色が見える)。false にすると変換せず、数値をそのまま表示する
# ([Linux/macOS (SDL版)] は未対応で、常に変換しない)
color_management = true
# [Linux/macOS (SDL版) のみ] UI フォントのファイルパス (.ttf/.ttc/.otf)。
# 未指定なら Noto CJK 等の既知のシステムフォントを自動探索する
# font_path = /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

[save]
# JPEG で保存するときの品質 (1-100)。大きいほど高画質・大きいファイルになる
jpeg_quality = 90
# 上書き保存 (Ctrl+S) の前に確認ダイアログを出すか。
# 元の画像は元に戻せないので既定は true。毎回聞かれるのが煩わしければ false
confirm_overwrite = true

[print]
# 印刷 (Ctrl+P) の余白 (mm, 0-50)。用紙の印刷可能領域からさらにこれだけ空ける。
# 画像は残った領域に縦横比を保って最大の大きさで、中央に配置される
# (プリンタ・用紙・向き・部数は印刷ダイアログで選ぶ)
margin_mm = 10
# 画像と用紙の向きが違うとき、90 度回して大きく刷るか。
# false にすると用紙の向きのまま(余白が広くなる)刷る
auto_rotate = true
# ([Linux/macOS (SDL版)] は印刷未対応。Ctrl+P はその旨をステータスバーに出す)

[cache]
# デコード済み画像(ピクセルデータ)を保持する量の上限。
# 表示中の画像と先読みした前後の画像がここに入る。上限を超えると古い方から捨て、
# 必要になった時点で再デコードする。表示中の 1 枚は上限を超えても捨てない
# (4000万画素の写真 1 枚で 160MB 使う。下げるほど前後への移動で再デコードが増え、
#  上げるほどメモリを使う)
# 合計の上限 (MB, 32-16384)
max_memory_mb = 512
# 保持する枚数の上限 (2-64)。[view] prefetch_radius を大きくするならこちらも
# 増やすこと(先読みが枚数上限に当たると、読んだ直後に捨てられて無駄になる)
max_items = 8

[mouse]
# 左右ボタンの役割を入れ替える。入れ替わるのは「画像のパン(スクロール)」と
# 「編集ドラッグ(現在のツールの実行)」の 2 つだけで、true にすると
# 左ドラッグで図形を描き、右ドラッグでパンするようになる。
# 図形・テキストを掴む操作(選択・移動・回転・サイズ変更)は入れ替えの対象外で、
# 入れ替えても常に左クリック。メニュー(ツール切り替え・オブジェクト・書式)も
# 対象外で常に右クリック(ドラッグなし)。サイドバーの項目クリックも常に左ボタン
swap_buttons = false

# 中ボタン・サイドボタン・ホイール・ダブルクリックには [keys] と同じコマンドを
# 割り当てられる(書式は「コマンド = 操作1, 操作2, ...」)。使える操作の表記:
#   Middle X1 X2 DoubleClick WheelUp WheelDown WheelLeft WheelRight
#   (X1/X2 = サイドボタンの戻る/進む、WheelLeft/Right = 水平ホイール(チルト))
#   修飾キーは Ctrl+ / Shift+ / Alt+ を前に付ける
# 既定: next = X2, WheelRight, Ctrl+WheelDown
#       prev = X1, WheelLeft,  Ctrl+WheelUp
#       (中ボタンとダブルクリックは既定では未割り当て。ダブルクリックは
#        テキスト注釈の再編集が優先で、そこに当たらなかったときだけ効く)
#
# ホイールでのズームは割り当てではなく「割り当てのないホイールの既定動作」なので、
# 素のホイールを遷移で埋めれば Ctrl+ホイールがズームになる(モード設定は不要):
#next = WheelDown
#prev = WheelUp
# 中ボタンでフィット、ダブルクリックでフルスクリーンにする例:
#fit = Middle
#fullscreen = DoubleClick

# 水平ホイール(WheelLeft/WheelRight)を 1 回と数えるまでのノッチ数 (1-10、既定 1)。
# トラックボールやタッチパッドは縦スクロール中に微小な横成分が混ざり続け、それが
# 積み上がって画像が勝手に切り替わることがある。2〜3 にすると意図して倒したときだけ
# 効くようになる(普通のチルトホイールなら既定の 1 のままでよい)。
# なお垂直ホイールを回すと横の貯金は捨てられ、サイドバー(ファイル一覧・操作一覧)の
# 上では水平ホイールは効かない。この 2 つは設定によらず常に有効
#wheel_horizontal_threshold = 2

[edit]
# 編集ドラッグ(既定では右ドラッグ。[mouse] swap_buttons = true なら左ドラッグ)は
# 「現在のツール」(トリミング / 矩形 / 楕円 / 矢印 / 直線 / テキスト)を
# その場で実行する。ツールの切り替えは何もない場所での右クリック(ドラッグなし)で
# 開くメニュー、または [keys] の tool_* コマンド。現在のツールはステータスバーに出る。
# 以下は新規作成時の初期値で、同じメニュー(線の太さ・文字サイズ・色の変更)から
# その場で変更できる。追加済みオブジェクトは左クリック(swap_buttons によらず左)で
# 選択して移動・回転・右クリックメニューで個別に変更できる
# 起動時のツール: crop / ocr / rect / ellipse / arrow / line / pen / marker / number / text
# (pen = 手書き、marker = 半透明の太い手書き、number = 連番の数字入りマーカー、
#  ocr = 選んだ範囲の文字を認識してコピー。画像は変えない)
tool = rect
# 図形・テキストの色 (RRGGBB)
color = FF3B30
# 線の太さ (画像px基準, 1-100。表示ズームによらず画像上のピクセル数で決まる)
# マーカーはこの 4 倍の太さで、不透明度 40% で描かれる
stroke_width = 3
# テキストの文字サイズ (画像px基準, 6-200)
font_size = 18
# テキストのフォント (フォントファミリ名。未指定なら Yu Gothic)
# メニューの候補にない名前も書ける。入っていない場合は代替フォントで描かれる
# font_family = Meiryo
# 矩形・楕円・テキストの塗りつぶし色 (RRGGBB)
fill_color = FFFFFF
# 塗りつぶしの不透明度 (0-255)。0 は塗らない = 下の画像が透けたまま
fill_alpha = 0
# テキストボックスの枠線色 (RRGGBB)
border_color = 000000
# テキストボックスの枠線幅 (画像px基準, 0-100)。0 は枠線なし
border_width = 0

[keys]
# コマンド = キー1, キー2, ... (記述したコマンドのデフォルトキーは置き換えられる)
# 修飾キーは Ctrl+ / Shift+ / Alt+。キー名の例:
#   Left Right Up Down Home End PageUp PageDown Space Enter Esc
#   Backspace Delete Tab Insert F1-F12 + - A-Z 0-9
#
# 使えるコマンド:
#   next prev first last zoom_in zoom_out fit actual_size
#   pan_left pan_right pan_up pan_down rotate_cw rotate_ccw
#   fullscreen open copy_image copy_path copy_file copy_ocr_text paste save save_as
#     (save = 元のファイルへ上書き保存、save_as = 名前を付けて保存)
#   undo redo delete_annotation resize
#     (resize = 倍率・長辺のプリセットメニューを出して画像をリサイズ)
#   sort_name sort_date sort_size sort_ext sort_reverse sort_cycle recursive
#     (一覧の並び順。既定のキーは割り当てていない ―― サイドバーの右クリックが入口。
#      sort_* は同じキーを選び直すと昇順 / 降順が入れ替わる)
#   sidebar statusbar help escape quit
#   tool_crop tool_ocr tool_rect tool_ellipse tool_arrow tool_line tool_pen tool_marker
#   tool_number tool_text
#     (右ドラッグで実行するツールの切り替え。既定のキーは割り当てていない)
#
# 例: Vim風の移動にする場合
#next = L, Right, Space
#prev = H, Left, Backspace
#
# 例: 注釈ツールをキーで切り替える場合(既定で使っていないキーを選ぶこと。
# 他コマンドが使っているキーを書くと、そちらのバインドが奪われる)
#tool_rect = X
#tool_arrow = A
#tool_pen = P
#tool_text = T

[ocr]
# 文字認識 (Ctrl+T、または ocr ツールで範囲を選ぶ) に使う言語 (BCP-47)。
# 空ならユーザーの表示言語から自動で選び、その認識器が無ければ入っている
# 言語のどれかで動く。例: ja / en-US / zh-Hans
#
# Windows 内蔵の文字認識を使うため追加のインストールは不要だが、言語ごとの
# 認識器が入っている必要がある(設定 → 時刻と言語 → 言語と地域 で、言語の
# 「オプション」から追加できる)。入っていない場合は、使える言語の一覧が
# ステータスバーに出る。SDL 版 (Linux/macOS) は未対応
#language = ja
